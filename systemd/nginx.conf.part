# Carte Réseau (Next.js, service carte_reseau) — https://carte_reseau.lemarc.fr
#
# Inclus au niveau http, comme tous les sites de ~/Web, par
# /etc/nginx/sites-available/tokamac :
#   include /home/Marc/Web/*/systemd/nginx.conf.part;
#
# Pas de ssl_certificate ici : le certificat est déclaré globalement dans
# /etc/nginx/nginx.conf.

upstream carte_reseau {
    server 127.0.0.1:3000;
    keepalive 8;          # connexions persistantes vers Next.js
}

server {
    listen 443 ssl;
    http2 on;
    server_name carte_reseau.lemarc.fr carte-reseau.lemarc.fr;

    access_log /var/log/nginx/carte_reseau.access.log;
    error_log  /var/log/nginx/carte_reseau.error.log;

    # gzip est actif globalement mais seulement pour text/html : /api/plants pèse ~850 Ko de JSON
    gzip_types application/json application/javascript text/css image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        proxy_pass http://carte_reseau;
        proxy_http_version 1.1;
        proxy_set_header Connection "";     # requis pour le keepalive de l'upstream
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Fichiers versionnés de Next.js : Next envoie déjà
    # "Cache-Control: public, max-age=31536000, immutable", on évite juste de
    # journaliser chaque chunk.
    location /_next/static/ {
        proxy_pass http://carte_reseau;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        access_log off;
    }
}
