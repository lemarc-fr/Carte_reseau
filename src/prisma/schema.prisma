generator client {
  provider = "prisma-client-js"
}

// PostgreSQL : le SQL brut de lib/downsample.ts et lib/power/store.ts (date_trunc,
// unnest, ON CONFLICT, AT TIME ZONE) lui est spécifique.
//
// Prisma 7 : l'URL de connexion ne se met plus ici, elle va dans prisma.config.ts
// (pour le CLI/migrate) et est passée via un driver adapter au PrismaClient
// (voir lib/prisma.ts). Voir https://pris.ly/d/config-datasource
datasource db {
  provider = "postgresql"
}

enum Granularity {
  HOUR
  DAY
}

// Site de production : centrale, ou installations d'une même filière regroupées par
// commune (éolien, solaire...). Alimenté par src/prisma/seed.ts à partir de dataset/<pays>/final/.
model Plant {
  id                 String    @id // slug stable, ex. "gravelines", "hydro-revin", "eolien-51163"
  country            String    @default("FR") // code ISO 3166-1 alpha-2
  name               String // nom court affiché, ex. "Gravelines"
  full_name          String
  // NUCLEAR | HYDRO | PUMPED_STORAGE | WIND | SOLAR | GAS | OIL | COAL | BIOENERGY | BATTERY
  production_type    String    @default("NUCLEAR")
  technology         String? // ex. "Lac", "Fil de l'eau", "onshore", "offshore"
  operator           String?
  latitude           Float
  longitude          Float
  capacity_mw        Float // puissance installée totale
  commissioning_date DateTime? @db.Date
  commune            String?
  departement        String?
  region             String?
  region_code        String? // code de la région dans le pays (INSEE en France), pour l'estimation
  installations      Int? // nombre d'installations du registre ODRE regroupées
  wikidata_id        String?
  osm_id             String? // ex. "relation/20240158"
  contour            Json? // anneau extérieur simplifié [[lon, lat], ...]
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  units Unit[]

  @@index([country])
  @@map("plants")
}

// Groupe de production publié individuellement par RTE (réacteur, groupe hydraulique,
// éolienne en mer...), identifié par son code EIC.
model Unit {
  eic_code           String    @id
  name               String
  production_type    String    @default("NUCLEAR") // type RTE, ex. NUCLEAR, HYDRO_PUMPED_STORAGE
  plant_id           String?
  capacity_mw        Float?
  commissioning_date DateTime? @db.Date
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  plant    Plant?              @relation(fields: [plant_id], references: [id])
  readings ProductionReading[]

  @@index([plant_id])
  @@map("units")
}

// Relevés de production par créneau (1h pendant 7 jours, puis 1 jour au-delà)
model ProductionReading {
  eic_code        String
  name            String
  production_type String
  start_date      DateTime
  granularity     Granularity @default(HOUR)
  value           Float
  updated_date    DateTime
  created_at      DateTime    @default(now())

  unit Unit @relation(fields: [eic_code], references: [eic_code])

  // Clé composite = pas besoin d'id séparé, et sert de cible pour les upserts
  // (create/update en une seule opération, idempotent si on rejoue une ingestion).
  @@id([eic_code, start_date, granularity])
  // Index pour les requêtes cumulées (toutes centrales) et le job de downsampling,
  // qui filtrent par start_date/granularity sans passer par eic_code.
  @@index([start_date, granularity])
  @@map("production_readings")
}

// Séries agrégées, même rétention que les relevés par groupe (horaire 7 jours, puis journalier) :
//   "<pays>:<TYPE>"            production nationale par filière, MW (ex. "FR:NUCLEAR", "FR:BATTERY")
//   "<pays>-<région>:<FILIÈRE>" taux de charge régional, 0-1, négatif quand des batteries se
//                              rechargent (ex. "FR-84:WIND", "FR-84:SOLAR", "FR-84:BATTERY")
model AggregateReading {
  series       String
  start_date   DateTime
  granularity  Granularity @default(HOUR)
  value        Float
  updated_date DateTime
  created_at   DateTime    @default(now())

  @@id([series, start_date, granularity])
  @@index([start_date, granularity])
  @@map("aggregate_readings")
}
