# Carte Réseau — configuration (copier en .env, jamais versionné)

# PostgreSQL
DATABASE_URL="postgresql://user:motdepasse@127.0.0.1:5432/nuclear_production"

# RTE — application data.rte-france.com abonnée à l'API « Actual Generation »
RTE_CLIENT_ID=""
RTE_CLIENT_SECRET=""

# Début de l'historique de production à rapatrier depuis RTE (jour YYYY-MM-DD, heure de Paris).
# Au démarrage, le serveur complète la base depuis cette date (moyennes journalières au-delà
# de 7 jours). Vide : seuls les 7 derniers jours sont récupérés.
BACK_FILL_START="2026-01-01"

# Météo-France — clé de l'API publique AROME (portail-api.meteofrance.fr), pour la couche vent
METEO_FRANCE_API_KEY=""
